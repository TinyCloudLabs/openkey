generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// better-auth User model
model User {
  id              String   @id
  email           String   @unique
  emailVerified   Boolean  @default(false)
  name            String?
  image           String?
  autoSignEnabled Boolean  @default(true)
  tinyCloudManageKeyEnabled Boolean @default(true)
  tinyCloudManageKeyMode String @default("APP_MANAGED")
  tinyCloudManageKeyPolicyEpoch BigInt @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  passkeys                       Passkey[]
  ethereumKeys                   EthereumKey[]
  tinyCloudBootstrapState        TinyCloudBootstrapState[]
  sessions                       Session[]
  accounts                       Account[]
  userEncryptionKey              UserEncryptionKey?
  verification                   Verification[]
  // OAuth provider relations
  oauthClients                   OauthClient[]
  oauthAccessTokens              OauthAccessToken[]
  oauthRefreshTokens             OauthRefreshToken[]
  oauthConsents                  OauthConsent[]
  tinyCloudManageKeyAppPreferences TinyCloudManageKeyAppPreference[]
  tinyCloudManageKeyControlEvents  TinyCloudManageKeyControlEvent[]
  tinyCloudManageKeySigningDecisions TinyCloudManageKeySigningDecision[]
  developerAccount               DeveloperAccount?
  organizationMemberships        OrganizationMembership[]

  @@map("user")
}

// better-auth Session
model Session {
  id            String    @id
  userId        String
  token         String    @unique
  expiresAt     DateTime
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  ipAddress     String?
  userAgent     String?
  lastPasskeyAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

// better-auth Account (for OAuth providers)
model Account {
  id                    String    @id
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("account")
}

// better-auth Verification (for email OTP)
model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String?

  @@map("verification")
}

// better-auth Passkey credentials
model Passkey {
  id           String   @id
  userId       String
  name         String?
  publicKey    String
  credentialID String   @unique
  counter      Int      @default(0)
  deviceType   String
  backedUp     Boolean
  transports   String?
  aaguid       String?
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("passkey")
}

// Legacy table retained in the executable migration chain.
model UserEncryptionKey {
  id               String   @id
  userId           String   @unique
  publicKey        String
  sealedPrivateKey String
  createdAt        DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, map: "user_encryption_key_userId_fkey")

  @@map("user_encryption_key")
}

enum KeyType {
  MANAGED
  EXTERNAL
}

enum KeyPurpose {
  PERSONAL
  MANAGED_ACCOUNT
}

// Ethereum keys - managed (sealed with TEE) or external (user-provided address)
model EthereumKey {
  id             String     @id @default(cuid())
  userId         String?
  address        String     @unique
  publicKey      String
  sealedBlob     String? // Encrypted with dstack KMS; null for external keys
  // Null is retained for pre-v1 rows. New keys use an opaque, immutable
  // per-key context; resolution falls back to openkey/user/{userId}/keys only
  // for these legacy rows. See docs/managed-accounts-migration-note.md.
  sealingContext String?    @unique(map: "ethereum_keys_sealingContext_key")
  keyType        KeyType    @default(MANAGED)
  keyPurpose     KeyPurpose @default(PERSONAL)
  // The single TEE-managed identity exposed to OIDC applications through
  // tinycloud:manage-key. A partial unique index in the migration enforces
  // at most one active canonical key for each user.
  isCanonicalTinyCloud Boolean @default(false)
  keyIndex       Int        @default(0)
  label          String?
  archivedAt     DateTime? // Soft delete - archived keys are hidden but not deleted
  createdAt      DateTime   @default(now())

  user                    User?                     @relation(fields: [userId], references: [id], onDelete: SetNull)
  tinyCloudBootstrapState TinyCloudBootstrapState[]

  @@unique([id, userId], map: "ethereum_keys_id_userId_key")
  @@index([userId, keyPurpose], map: "ethereum_keys_userId_keyPurpose_idx")
  @@map("ethereum_keys")
}

model TinyCloudBootstrapState {
  id               String    @id @default(cuid())
  userId           String
  keyId            String
  address          String
  chainId          Int
  tinycloudHost    String
  bootstrapVersion String
  status           String
  attemptId        String?
  lockExpiresAt    DateTime?
  checkedAt        DateTime
  completedAt      DateTime?
  failureCode      String?
  failureReason    String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  key  EthereumKey @relation(fields: [keyId], references: [id], onDelete: Cascade)

  @@unique([keyId, chainId, tinycloudHost, bootstrapVersion], map: "tinycloud_bootstrap_state_keyId_chainId_tinycloudHost_bootstrap")
  @@index([userId])
  @@index([status])
  @@map("tinycloud_bootstrap_state")
}

// better-auth JWKS (required by JWT plugin)
model Jwks {
  id         String   @id
  publicKey  String
  privateKey String
  createdAt  DateTime @default(now())

  @@map("jwks")
}

// ======= OAuth 2.1 Provider tables =======

enum Plan {
  FREE
  PRO
  // Retained only until production data is explicitly audited and mapped.
  // SCALE is not a public v1 plan; never map it implicitly in application code.
  SCALE
  ENTERPRISE
}

enum BillingState {
  FREE // No Stripe subscription
  ACTIVE // Paying, subscription current
  PAST_DUE // Payment failed
  CANCELLED // Subscription ended
}

// DeveloperAccount — 1:1 with User, created on first admin console login
model DeveloperAccount {
  id                   String       @id @default(cuid())
  userId               String       @unique
  stripeCustomerId     String?      @unique
  plan                 Plan         @default(FREE)
  billingState         BillingState @default(FREE)
  mauLimit             Int          @default(1000)
  appLimit             Int          @default(3)
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  stripeSubscriptionId String?
  // Transitional bridge to the organization tenant boundary. Existing rows
  // remain user-owned until an explicit, audited migration assigns an org.
  organizationId       String?      @unique(map: "developer_account_organizationId_key")

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull, map: "developer_account_org_fkey")

  @@map("developer_account")
}

// Daily analytics rollup keyed by clientId
model OauthDailyStats {
  id                  String   @id @default(cuid())
  clientId            String
  date                DateTime @db.Date
  uniqueUsers         Int      @default(0)
  totalAuthorizations Int      @default(0)
  totalTokenExchanges Int      @default(0)

  @@unique([clientId, date])
  @@index([clientId])
  @@map("oauth_daily_stats")
}

// Registered OAuth clients (third-party applications)
model OauthClient {
  id                      String   @id
  clientId                String   @unique
  clientSecret            String? // Hashed, null for public clients
  name                    String
  uri                     String? // Application website
  icon                    String? // Logo URL
  redirectUris            String[] // Array of allowed redirect URIs
  scopes                  String[] // Allowed scopes for this client
  tinycloudSessionPolicy  String?  // Dashboard-managed automatic signing policy
  tinycloudSessionOrigin  String?  // Exact browser origin allowed by that policy
  disabled                Boolean  @default(false)
  skipConsent             Boolean  @default(false) // Always false for OpenKey
  enableEndSession        Boolean  @default(false)
  tokenEndpointAuthMethod String? // "client_secret_basic", "client_secret_post", "none"
  grantTypes              String[] @default(["authorization_code", "refresh_token"])
  responseTypes           String[] @default(["code"])
  type                    String? // "web", "native", "spa"
  public                  Boolean  @default(false)
  contacts                String[]
  tos                     String? // Terms of service URL
  policy                  String? // Privacy policy URL
  softwareId              String?
  softwareVersion         String?
  softwareStatement       String?
  metadata                Json?
  userId                  String? // Owner of the client (admin who registered it)
  referenceId             String?
  organizationId          String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  user                User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  organization        Organization?        @relation(fields: [organizationId], references: [id], onDelete: SetNull, map: "oauth_client_org_fkey")
  tinyCloudManageKeyAppPreferences TinyCloudManageKeyAppPreference[]

  @@unique([clientId, organizationId], map: "oauth_client_clientId_organizationId_key")
  @@index([organizationId], map: "oauth_client_organizationId_idx")
  @@map("oauth_client")
}

// OAuth access tokens
model OauthAccessToken {
  id          String   @id
  token       String   @unique
  clientId    String
  userId      String
  sessionId   String?
  refreshId   String? // Associated refresh token
  referenceId String?
  scopes      String[]
  createdAt   DateTime @default(now())
  expiresAt   DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
  @@map("oauth_access_token")
}

model CoordinationosSessionGrant {
  id                 String   @id @default(cuid())
  createdAt          DateTime @default(now())
  oauthAccessTokenId String   @unique
  nonceDigest        String   @unique
  clientId           String
  userId             String
  keyId              String
  decisionId         String   @unique

  @@index([clientId])
  @@index([userId])
  @@index([keyId])
  @@map("coordinationos_session_grant")
}

model CoordinationosSigningDecision {
  id                 String   @id @default(cuid())
  occurredAt         DateTime @default(now())
  policyVersion      String
  decision           String
  reasonCode         String
  requestId          String?
  oauthAccessTokenId String?
  tokenDigest        String?
  clientId           String?
  userId             String?
  keyId              String?
  origin             String?
  chainId            Int?
  purpose            String?
  type               String?
  siweDigest         String?
  capabilityDigest   String?
  nonceDigest        String?
  issuedAt           String?
  expirationTime     String?
  sessionTtlSeconds  Int?
  evidence           Json

  @@index([occurredAt])
  @@index([decision])
  @@index([reasonCode])
  @@index([clientId])
  @@index([userId])
  @@index([keyId])
  @@map("coordinationos_signing_decision")
}

// OAuth refresh tokens
model OauthRefreshToken {
  id          String   @id
  token       String   @unique
  clientId    String
  userId      String
  sessionId   String?
  referenceId String?
  scopes      String[]
  revoked     DateTime?
  authTime    DateTime?
  createdAt   DateTime @default(now())
  expiresAt   DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
  @@map("oauth_refresh_token")
}

// User consent records
model OauthConsent {
  id          String   @id
  userId      String
  clientId    String
  referenceId String?
  scopes      String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, clientId])
  @@map("oauth_consent")
}

// A user-owned, immediate stop control for an OAuth application's
// tinycloud:manage-key consent. Missing rows mean the active OAuth consent is
// enabled; explicit rows preserve a user's disabled choice across refreshes.
model TinyCloudManageKeyAppPreference {
  userId    String
  clientId  String
  enabled   Boolean  @default(true)
  status    String   @default("ENABLED")
  clientNameSnapshot String?
  clientUriSnapshot String?
  consentWithdrawnAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  client OauthClient @relation(fields: [clientId], references: [clientId], onDelete: Restrict)

  @@id([userId, clientId])
  @@index([clientId])
  @@map("tinycloud_manage_key_app_preference")
}

// Append-only evidence for user-controlled TinyCloud signing policy changes.
// Request hashes are safe to retain; raw bearer tokens and signing payloads are not.
model TinyCloudManageKeyControlEvent {
  id String @id
  userId String
  policyEpoch BigInt
  action String
  mode String
  clientId String?
  requestDigest String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("tinycloud_manage_key_control_event")
}

// The final policy decision made immediately before producing a signature.
model TinyCloudManageKeySigningDecision {
  id String @id
  userId String
  clientId String
  policyEpoch BigInt
  allowed Boolean
  reason String
  requestDigest String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, clientId, createdAt])
  @@map("tinycloud_manage_key_signing_decision")
}

// ======= Developer Organizations =======

enum OrganizationRole {
  ADMIN
  MEMBER
}

enum MembershipStatus {
  ACTIVE
  REVOKED
}


model Organization {
  id                   String       @id @default(cuid())
  name                 String
  plan                 Plan         @default(FREE)
  billingState         BillingState @default(FREE)
  stripeCustomerId     String?      @unique(map: "organization_stripeCustomerId_key")
  stripeSubscriptionId String?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  developerAccount DeveloperAccount?
  memberships      OrganizationMembership[]
  oauthClients     OauthClient[]
  planEntitlements PlanEntitlements?

  @@map("organization")
}

model OrganizationMembership {
  id             String           @id @default(cuid())
  organizationId String
  userId         String
  role           OrganizationRole @default(MEMBER)
  status         MembershipStatus @default(ACTIVE)
  validFrom      DateTime         @default(now())
  validUntil     DateTime?
  revokedAt      DateTime?
  createdAt      DateTime         @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, map: "membership_org_fkey")
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade, map: "membership_user_fkey")

  @@unique([organizationId, userId, validFrom], map: "organization_membership_org_user_from_key")
  @@index([organizationId, status], map: "organization_membership_org_status_idx")
  @@index([userId, status], map: "organization_membership_user_status_idx")
  @@map("organization_membership")
}

model PlanEntitlements {
  id                     String   @id @default(cuid())
  organizationId         String   @unique
  version                Int      @default(1)
  maxApps                Int
  maxOrganizationMembers Int
  requestsPerMinute      Int
  auditRetentionDays     Int
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, map: "plan_entitlements_org_fkey")

  @@map("plan_entitlements")
}
