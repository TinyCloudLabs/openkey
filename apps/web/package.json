{
  "name": "@openkey/web",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "dev:portless": "PORTLESS_WILDCARD=1 portless run --name openkey vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test:cloudflare-artifact": "vite build && bun test tests/cloudflare-artifact.test.ts",
    "test:cloudflare-runtime": "vite build && bun test tests/cloudflare-runtime.test.ts",
    "test:browser": "playwright test --config tests/browser/playwright.config.ts"
  },
  "dependencies": {
    "@better-auth/oauth-provider": "^1.6.9",
    "@better-auth/passkey": "^1.6.9",
    "@openkey/capability-review": "workspace:*",
    "better-auth": "^1.6.9"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@sveltejs/adapter-cloudflare": "^7.0.0",
    "@sveltejs/kit": "^2.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "happy-dom": "^20.11.1",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "^6.0.0",
    "vite": "^8.0.0"
  }
}
