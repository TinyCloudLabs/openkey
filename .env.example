# Database
# Local dev uses in-process PGlite by default.
# Reserved for the isolated production migration-deploy parity check only:
# run `bun docker:up` and use:
# DATABASE_URL=postgresql://openkey:openkey@localhost:5432/openkey
DATABASE_URL=pglite:

# Ports
API_PORT=3001
WEB_PORT=5173
ADMIN_PORT=5174

# Service URLs (update these if you change ports)
API_URL=http://localhost:3001
WEB_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174
# The API's better-auth allowlist for session-bearing requests from the
# dedicated administrative console. Set this in production.
CONSOLE_ORIGIN=
# VITE_API_URL - only needed in production (e.g. https://api.openkey.so)
# In dev, the Vite proxy handles /api routing to API_URL
# In production, set VITE_CONSOLE_ORIGIN=https://console.openkey.so. Omit it
# locally to keep the console on the same Vite host without DNS.
VITE_CONSOLE_ORIGIN=

# WebAuthn / Passkey
# Production: WEBAUTHN_RP_ID=openkey.so, WEBAUTHN_ORIGIN=https://openkey.so
# Console sign-in is handed back to this account origin; the API session cookie
# is shared across *.openkey.so.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:5173

# Auth
BETTER_AUTH_SECRET=<generate-a-random-secret>
BETTER_AUTH_URL=http://localhost:3001
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# OAuth - Google
GOOGLE_CLIENT_ID=<your-google-client-id>
GOOGLE_CLIENT_SECRET=<your-google-client-secret>

# OAuth - Apple (web Services ID + Sign in with Apple key)
APPLE_CLIENT_ID=<your-apple-services-id>
APPLE_TEAM_ID=<your-apple-team-id>
APPLE_KEY_ID=<your-apple-key-id>
# PEM text may contain literal newlines or escaped \\n sequences.
APPLE_PRIVATE_KEY=<your-apple-p8-private-key>
# Optional, only needed when accepting native Apple ID tokens too.
APPLE_APP_BUNDLE_IDENTIFIER=<your-apple-app-bundle-id>

# TEE Mode
TEE_MODE=development
DEV_SEALING_KEY=<32-byte-hex-key-for-local-dev>

# Email (Resend)
RESEND_API_KEY=<your-resend-api-key>

# Admin
OPENKEY_API_URL=https://api.openkey.so
ADMIN_API_KEY=your-secret-key
INTERNAL_METRICS_TOKEN=your-internal-metrics-token
