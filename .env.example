# Database
# Local dev uses in-process PGlite by default.
# For prod-parity testing, run `bun docker:up` and use:
# DATABASE_URL=postgresql://openkey:openkey@localhost:5432/openkey
DATABASE_URL=pglite:

# Ports
API_PORT=3001
WEB_PORT=5173
ADMIN_PORT=5174

# Service URLs (update these if you change ports)
API_URL=http://localhost:3001
WEB_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174
# The API's better-auth allowlist for session-bearing requests from the
# dedicated administrative console. Set this in production.
CONSOLE_ORIGIN=
# VITE_API_URL - only needed in production (e.g. https://api.openkey.so)
# In dev, the Vite proxy handles /api routing to API_URL
# In production, set VITE_CONSOLE_ORIGIN=https://console.openkey.so. Omit it
# locally to keep the console on the same Vite host without DNS.
VITE_CONSOLE_ORIGIN=
# Optional, comma-separated additions to the /delegate page's built-in lists
# (apps/web/src/lib/delegate-link-policy.ts). VITE_DELEGATE_CALLBACK_URLS:
# app callback endpoints (canonical HTTPS origin + path, no query), e.g.
# https://mcp.staging.example/connect/callback. VITE_DELEGATE_NODE_ORIGINS:
# canonical HTTPS TinyCloud node origins shown without a warning.
VITE_DELEGATE_CALLBACK_URLS=
VITE_DELEGATE_NODE_ORIGINS=

# WebAuthn / Passkey
# Production: WEBAUTHN_RP_ID=openkey.so, WEBAUTHN_ORIGIN=https://openkey.so
# Console sign-in is handed back to this account origin; the API session cookie
# is shared across *.openkey.so.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:5173

# Auth
BETTER_AUTH_SECRET=<generate-a-random-secret>
BETTER_AUTH_URL=http://localhost:3001
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# Cloudflare Turnstile (new-account sign-up only; sign-in is never challenged).
# The values below are Cloudflare's public TEST keys: they always pass and do
# not prove a human. Production sets real keys in .env.prod. If
# TURNSTILE_SECRET_KEY is unset, new sign-ups pause (fail closed).
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
# Optional: public hostname the widget runs on. Set it in production; unset = not checked.
TURNSTILE_EXPECTED_HOSTNAME=
# QA registration bypass: leave empty outside QA environments. Compared in
# constant time; the previous value is accepted during rotation.
OPENKEY_QA_REGISTRATION_SECRET=
OPENKEY_QA_REGISTRATION_SECRET_PREVIOUS=

# OAuth - Google
GOOGLE_CLIENT_ID=<your-google-client-id>
GOOGLE_CLIENT_SECRET=<your-google-client-secret>

# OAuth - Apple (web Services ID + Sign in with Apple key)
APPLE_CLIENT_ID=<your-apple-services-id>
APPLE_TEAM_ID=<your-apple-team-id>
APPLE_KEY_ID=<your-apple-key-id>
# PEM text may contain literal newlines or escaped \\n sequences.
APPLE_PRIVATE_KEY=<your-apple-p8-private-key>
# Optional, only needed when accepting native Apple ID tokens too.
APPLE_APP_BUNDLE_IDENTIFIER=<your-apple-app-bundle-id>

# TEE Mode
TEE_MODE=development
DEV_SEALING_KEY=<32-byte-hex-key-for-local-dev>

# Email (Resend)
RESEND_API_KEY=<your-resend-api-key>

# Admin
OPENKEY_API_URL=https://api.openkey.so
ADMIN_API_KEY=your-secret-key
INTERNAL_METRICS_TOKEN=your-internal-metrics-token
# Bearer for /api/internal/scoreboard (aggregate counts only); the node's read-only
# GET /admin/stats URL and token it reads owner addresses from; and the
# account/client lists excluded from the counts (comma-separated ids).
OPENKEY_METRICS_READ_TOKEN=your-scoreboard-read-token
NODE_STATS_URL=
NODE_STATS_READ_TOKEN=
SCOREBOARD_EXCLUDE_USER_IDS=
SCOREBOARD_EXCLUDE_CLIENT_IDS=
