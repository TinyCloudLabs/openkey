# Database
# Local dev uses in-process PGlite by default.
# For prod-parity testing, run `bun docker:up` and use:
# DATABASE_URL=postgresql://openkey:openkey@localhost:5432/openkey
DATABASE_URL=pglite:

# Ports
API_PORT=3001
WEB_PORT=5173
ADMIN_PORT=5174

# Service URLs (update these if you change ports)
API_URL=http://localhost:3001
WEB_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174
# The API's better-auth allowlist for session-bearing requests from the
# dedicated administrative console. Set this in production.
CONSOLE_ORIGIN=
# VITE_API_URL - only needed in production (e.g. https://api.openkey.so)
# In dev, the Vite proxy handles /api routing to API_URL
# In production, set VITE_CONSOLE_ORIGIN=https://console.openkey.so. Omit it
# locally to keep the console on the same Vite host without DNS.
VITE_CONSOLE_ORIGIN=
# Optional, comma-separated additions to the /delegate page's built-in lists
# (apps/web/src/lib/delegate-link-policy.ts). VITE_DELEGATE_CALLBACK_URLS:
# app callback endpoints (canonical HTTPS origin + path, no query), e.g.
# https://mcp.staging.example/connect/callback. VITE_DELEGATE_NODE_ORIGINS:
# canonical HTTPS TinyCloud node origins shown without a warning.
VITE_DELEGATE_CALLBACK_URLS=
VITE_DELEGATE_NODE_ORIGINS=
# Optional, comma-separated: TinyCloud One's request-signing keys
# (did:key:z6Mk…) for this deployment. A one-tap approval request signed by a
# listed key is shown as from TinyCloud One; any other signer is shown as not
# verified, with no requester name.
VITE_TINYCLOUD_ONE_REQUESTER_DIDS=
# Set to `enabled` together with the API's OPENKEY_NETWORK_DECRYPT_CAP: the popup,
# frame and command-line approval screens then stop a whole network's decrypt at
# 7 days, as the API does. Off unless exactly `enabled`.
VITE_OPENKEY_NETWORK_DECRYPT_CAP=

# WebAuthn / Passkey
# Production: WEBAUTHN_RP_ID=openkey.so, WEBAUTHN_ORIGIN=https://openkey.so
# Console sign-in is handed back to this account origin; the API session cookie
# is shared across *.openkey.so.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:5173

# Auth
BETTER_AUTH_SECRET=<generate-a-random-secret>
BETTER_AUTH_URL=http://localhost:3001
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# OAuth - Google
GOOGLE_CLIENT_ID=<your-google-client-id>
GOOGLE_CLIENT_SECRET=<your-google-client-secret>

# OAuth - Apple (disabled unless the flag AND all credentials are set)
APPLE_SIGN_IN_ENABLED=false
APPLE_NATIVE_SIGN_IN_ENABLED=false
APPLE_CLIENT_ID=<your-apple-services-id>
APPLE_TEAM_ID=<your-apple-team-id>
APPLE_KEY_ID=<your-apple-key-id>
# PEM text may contain literal newlines or escaped \\n sequences.
APPLE_PRIVATE_KEY=<your-apple-p8-private-key>
# Reserved for a future PAR-bound native endpoint; never enables stock ID-token sign-in.
APPLE_APP_BUNDLE_IDENTIFIERS=<comma-separated-app-bundle-ids>
# Primary App ID Apple addresses server-to-server notifications to
# (/api/webhooks/apple); not found unless Apple sign-in is enabled.
APPLE_WEBHOOK_AUDIENCE=<your-apple-primary-app-id>

# TEE Mode
TEE_MODE=development
DEV_SEALING_KEY=<32-byte-hex-key-for-local-dev>

# Email (Resend)
RESEND_API_KEY=<your-resend-api-key>

# Admin
OPENKEY_API_URL=https://api.openkey.so
ADMIN_API_KEY=your-secret-key
INTERNAL_METRICS_TOKEN=your-internal-metrics-token
# Bearer for /api/internal/scoreboard (aggregate counts only); the node's read-only
# GET /admin/stats URL and token it reads owner addresses from; and the
# account/client lists excluded from the counts (comma-separated ids).
OPENKEY_METRICS_READ_TOKEN=your-scoreboard-read-token
NODE_STATS_URL=
NODE_STATS_READ_TOKEN=
SCOREBOARD_EXCLUDE_USER_IDS=
SCOREBOARD_EXCLUDE_ADDRESSES=
SCOREBOARD_DISPOSABLE_DOMAINS=
SCOREBOARD_EXCLUDE_CLIENT_IDS=
SCOREBOARD_EXCLUDE_EMAIL_PREFIXES=
# Empty by default; set to true or 1 to refuse native delegation renewals.
OPENKEY_NATIVE_RENEW_DISABLED=
# TC-3800: off unless exactly `enabled`. When on, a whole network's decrypt outside a signed approval request (/a/)
# lasts 7 days at most, like a grant on secret keys: the popup, link and frame bring a longer expiry back to 7 days,
# and signed bytes that ask for more (raw /sign, /complete, /authorize-sign) are refused. Set the web's
# VITE_OPENKEY_NETWORK_DECRYPT_CAP the same.
OPENKEY_NETWORK_DECRYPT_CAP=
# Renewal leases are off unless this is exactly `enabled`. Exactly `stop` is off and also revokes every live
# lease the API's own keys signed (checked every 5 minutes). On the production TinyCloud node a lease also
# needs the node DID and its renewer DID, as advertised at /.well-known/tinycloud/node-keys.
OPENKEY_RENEWAL_LEASES=
OPENKEY_RENEWAL_NODE_DID=
OPENKEY_RENEWAL_RENEWER_DID=
